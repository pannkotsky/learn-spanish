# Public contact email for the site (footer, privacy, terms). Optional; defaults when unset or empty.
# VITE_CONTACT_EMAIL=

# generate a secret with `pnpm dlx @better-auth/cli secret`
BETTER_AUTH_SECRET=

# Local PostgreSQL (Drizzle + Better Auth persistence).
# Example: postgresql://postgres:postgres@localhost:5432/learnspanish
DATABASE_URL=
