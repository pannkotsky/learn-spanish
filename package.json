{
  "name": "learn-spanish",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build:changelog": "tsx scripts/build-changelog-html.ts",
    "dev": "vite dev --port 3000",
    "prebuild": "pnpm build:changelog",
    "predev": "pnpm build:changelog && pnpm codegen",
    "prek:install": "prek install",
    "ts": "tsc --noEmit",
    "format": "biome check . --write",
    "format:check": "biome check .",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed-verbs": "tsx src/db/seed-verbs.ts",
    "db:seed-verb-forms": "tsx src/db/seed-verb-forms.ts",
    "db:seed": "pnpm db:seed-verbs && pnpm db:seed-verb-forms",
    "codegen": "graphql-codegen --config codegen.ts && pnpm biome format src/graphql/__generated__/graphql.ts --write"
  },
  "dependencies": {
    "@apollo/client": "^4.1.7",
    "@apollo/client-integration-tanstack-start": "0.14.5-rc.0",
    "@apollo/server": "^5.5.0",
    "@better-auth/drizzle-adapter": "^1.6.2",
    "@jirimracek/conjugate-esp": "^2.3.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.5.3",
    "dataloader": "^2.2.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "lucide-react": "^1.8.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typed-document-node": "^6.1.7",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@j178/prek": "^0.3.9",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "daisyui": "^5.5.19",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "marked": "^18.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
